# Copie este arquivo para ".env" (já está no .gitignore — nunca commitar o
# .env real) e preencha com a chave compartilhada de beta-teste.
#
# Chave do Gemini Developer API, gerada em https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Senha única compartilhada para acessar a interface web (beta-teste). Vazia
# = acesso liberado sem senha (a interface avisa nesse caso).
APP_PASSWORD=
